class Solution {
    String num;
    Long dp[][][][];
    int k;
    public long goodIntegers(long l, long r, int k) {
        this.k=k;
        return solve(r)-solve(l-1);
    }
    public long solve(long x){
if(x<0) return 0;
num=String.valueOf(x);
int n=num.length();
dp=new Long[n][11][2][2];
return dfs(0,10,1,0);
    }
    public long dfs(int pos, int prev,int tight,int started){
        if(pos==num.length()){
        return started==0?0:1;
        }
        if(dp[pos][prev][tight][started]!=null){
            return dp[pos][prev][tight][started];
        }
        int limit;
        if(tight==1){
            limit=num.charAt(pos)-'0';
        }else{
            limit=9;
        }
          long ans=0;
        for(int digit=0;digit<=limit;digit++){
          
            int newtight;
            if(tight==1&&digit==limit){
                newtight=1;
            }else{
                newtight=0;
            }

            if(started==0&&digit==0){
                ans=ans+dfs(pos+1,10,newtight,0);
            }else{
                if(prev!=10&&Math.abs(prev-digit)>k){
                    continue;
                }
                ans=ans+dfs(pos+1,digit,newtight,1);
            }
        }
        return dp[pos][prev][tight][started]=ans;
    }
}
