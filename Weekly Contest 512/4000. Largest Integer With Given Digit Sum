class Solution {
    public int largestInteger(int n, int s) {
        if(s==0) return 0;
        if(s>9*n) return -1;
        StringBuilder res=new StringBuilder();
        for(int i=0;i<n;i++){
            int digit=Math.min(9,s);
            res.append(digit);
            s-=digit;
        }
        return Integer.parseInt(res.toString());
    }
}
