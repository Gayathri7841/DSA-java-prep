class Solution {
    public int longestSubarray(int[] nums) {
        int left=0;
        int right=0;
        int count=0;
        int maxlen=0;
        int n=nums.length;
        while(right<n){
            if(nums[right]==1)right++;
            else{
right++;
count++;
            }
            while(count>1){
                if(nums[left]==0) count--;
                left++;
            }
            maxlen=Math.max(maxlen,right-left-1);
        }
        return maxlen;
    }
}
