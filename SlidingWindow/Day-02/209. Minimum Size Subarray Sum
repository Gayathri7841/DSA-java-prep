class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int left=0;
        int right=0;
        int sum=0;
        int min=Integer.MAX_VALUE;
        int n=nums.length;
        while(right<n&&left<=right){
           
            if(sum<target){
                 sum=sum+nums[right];
                 right++;
                
               
            }
            while(sum>=target){
                min=Math.min(min,right-left);
                sum=sum-nums[left];
                left++;
            }
            
        }
        if(min==Integer.MAX_VALUE) return 0;
        return min;
    }
}
