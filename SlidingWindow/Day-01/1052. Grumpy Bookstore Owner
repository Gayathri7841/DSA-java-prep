class Solution {
    public int maxSatisfied(int[] customers, int[] grumpy, int minutes) {
        int total=0;
       for(int i=0;i<customers.length;i++){
        if(grumpy[i]==0){
            total=total+customers[i];
        }
       }


       for(int i=0;i<customers.length;i++){
        if(grumpy[i]==0){
         customers[i]=0;
        }
       }

       // normal sliding window
int max=0,sum=0;
for(int i=0;i<minutes;i++){
    sum=sum+customers[i];
}
max=Math.max(max,sum);
if(minutes==customers.length) return total+max;
int left=1;
int right=minutes;
while(right<customers.length){
    sum=sum-customers[left-1];
    sum=sum+customers[right];
    max=Math.max(sum,max);
    left++;
    right++;
}
return max+total;

    }
}
