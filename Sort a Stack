class Solution {
    public void sortStack(Stack<Integer> st) {
     if(st.isEmpty()) return;
     int x=st.pop();
     sortStack(st);
     insertStack(x,st);

    }
    public void insertStack(int x,Stack<Integer> st){
        if(st.isEmpty()||st.peek()<=x){
            st.push(x);
            return;
        }
        int temp=st.pop();
        insertStack(x,st);
        st.push(temp);
    }
}
