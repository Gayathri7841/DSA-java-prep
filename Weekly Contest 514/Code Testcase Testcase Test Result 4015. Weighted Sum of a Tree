class Solution {
    int dp[];
    int parent[];
    public long weightedSum(int[] parent, int[] nums) {
        dp=new int[parent.length];
        this.parent=parent;
        int depth[]=new int[parent.length];
        int height=Integer.MIN_VALUE;
        for(int i=0;i<parent.length;i++){
            depth[i]=findDepth(i);
            height=Math.max(height,depth[i]);
        }
        long sum=0;
        for(int i=0;i<parent.length;i++){
            sum+=(long)nums[i]*(height-depth[i]+1);
        }
        return sum;
    }
    private int findDepth(int i){
if(parent[i]==-1) return 1;
        if(dp[i]!=0) return dp[i];
        return dp[i]= 1+findDepth(parent[i]);
    }
}
