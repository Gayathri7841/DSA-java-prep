class Solution {
    public String removeOuterParentheses(String s) {
        int counter=0;
        String ans="";
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
           if(ch=='('){
            counter++;
            if(counter>=2){
                ans=ans+ch;
            }
           }else{
            counter--;
            if(counter>0) ans=ans+ch;
           }

        }
        return ans;
    }
}
