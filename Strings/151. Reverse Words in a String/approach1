class Solution {
    public String reverseWords(String s) {
        String words[]=s.strip().split("\\s+");
        int left=0;
        int right=words.length-1;
        StringBuilder sb=new StringBuilder();
       
        while(left<right){
            String temp=words[left];
            words[left]=words[right];
            words[right]=temp;
            left++;
            right--;
        }
for(int i=0;i<words.length;i++){

    sb.append(words[i]);
    if(i!=words.length-1){
        sb.append(" ");
    }
    
}
return sb.toString();
    }
}
