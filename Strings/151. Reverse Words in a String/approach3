class Solution {
    public String reverseWords(String s) {
        char c[]=s.toCharArray();
        reverse(c,0,c.length-1);
        reverseWords(c);
        return cleanSpaces(c);
    }
    public void reverse(char c[],int start,int end){
       
        while(start<end){
            char temp=c[start];
            c[start]=c[end];
            c[end]=temp;
            start++;
            end--;
        }
       
    }
    public void reverseWords(char c[]){
        int start=0;  
        while(start<c.length){
            while(start<c.length&&c[start]==' '){
                start++;
            }
            if(start>=c.length) break;
            int end=start;
            while(end<c.length&&c[end]!=' '){
                end++;
            }
          reverse(c,start,end-1);
            
start=end;
        }
       
    }
    public String cleanSpaces(char c[]){
        StringBuilder sb=new StringBuilder();
        int start=0;
        while(start<c.length&&c[start]==' ') start++;
        int end=c.length-1;
        while(end>=0&&c[end]==' ')end--;
        int i=start;
        while(i<=end)   {
            while(i<=end&&c[i]!=' ') 
            {
            sb.append(c[i]);
i++;
            }
            while(i<=end&&c[i]==' ') i++;
if(i<=end) sb.append(' ');
        }
        return sb.toString();
    }
}
