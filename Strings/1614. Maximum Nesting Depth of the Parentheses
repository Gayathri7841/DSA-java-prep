class Solution {
    public int maxDepth(String s) {
        int len=s.length();
        int count=0;
        int max=Integer.MIN_VALUE;
        for(int i=0;i<len;i++){
            if(s.charAt(i)=='(') count++;
            else if(s.charAt(i)==')') count--;
            max=Math.max(count,max);
        }
        return max;
    }
}
