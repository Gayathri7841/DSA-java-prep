class Solution {
    String a,b;
    String n;
    long dp[][][]=new long[101][101][101];
    int mod=1000000007;
    public int interleaveCharacters(String word1, String word2, String target) {
        a=word1;
        b=word2;
        n=target;
        
         for(int i=0;i<101;i++)
            for(int j=0;j<101;j++)
                Arrays.fill(dp[i][j],-1);
        return (int)dfs(0,0,0);
        
    }
    public long dfs(int i,int j, int k){
        if(k==n.length()){
            if(i>0&&j>0) return 1;
            return 0;
        }
        if(i==a.length()&&j==b.length()) return 0;
        if(dp[i][j][k]!=-1) return dp[i][j][k];
        long ans=0;
        for(int x=i;x<a.length();x++){
            if(a.charAt(x)==n.charAt(k)){
                ans=(ans+dfs(x+1,j,k+1))%mod;
            }
        }
         for(int x=j;x<b.length();x++){
            if(b.charAt(x)==n.charAt(k)){
                ans=(ans+dfs(i,x+1,k+1))%mod;
            }
        }
        return dp[i][j][k]=ans;
    }
}
