class Solution {
    public int maxValidPairSum(int[] nums, int k) {
        int best=Integer.MIN_VALUE;
        int ans=Integer.MIN_VALUE;
        for(int j=k;j<nums.length;j++){
            int i=j-k;
            best=Math.max(best,nums[i]);
            ans=Math.max(ans,nums[j]+best);
        }
        return ans;
    }
}
