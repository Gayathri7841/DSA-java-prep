class Solution {
    public List<List<Integer>> generate(int numRows) {
        int n=numRows;
        int arr[][]=new int[n][n];
        arr[0][0]=1;
        for(int i=0;i<n;i++){
            arr[i][0]=1;
        }
        for(int i=1;i<n;i++){
            for(int j=1;j<n;j++){
                arr[i][j]=arr[i-1][j]+arr[i-1][j-1];
            }
        }
        List<List<Integer>> list=new ArrayList<>();
        for(int i=0;i<n;i++){
            List<Integer> row=new ArrayList<>();
            for(int j=0;j<=i;j++){
row.add(arr[i][j]);
            }
            list.add(row);
        }
        return list;
    }
}
