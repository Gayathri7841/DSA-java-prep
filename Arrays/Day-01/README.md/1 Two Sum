class Solution {
    public int[] twoSum(int[] nums, int target) {
       int a[][]=new int[nums.length][2];
       for(int i=0;i<nums.length;i++){
        a[i][0]=nums[i];
        a[i][1]=i;
       }
       Arrays.sort(a, (x, y) -> x[0] - y[0]);
        int left=0;
        int right=nums.length-1;
        int arr[]=new int[2];
        while(left<right){
            
            int sum=a[left][0]+a[right][0];
            if(sum>target){
                right--;
            }else if(sum<target){
                left++;
            }
            else{

arr[0]=a[left][1];
arr[1]=a[right][1];
break;


            }
        }
        return arr;
    }
}
