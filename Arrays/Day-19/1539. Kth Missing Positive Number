class Solution {
    public int findKthPositive(int[] arr, int k) {

        int n=arr.length;
        int nums[]=new int[n];
        for(int i=0;i<n;i++){
nums[i]=arr[i]-(i+1);
}
int low=0;
int high=n-1;
while(low<=high){
    int mid=low+(high-low)/2;
    if(nums[mid]<k){
        low=mid+1;
    }else{
        high=mid-1;
    }
}
if(high == -1) {
            return k;
        }
int diff=k-nums[high];
return arr[high]+diff;
    }
}
