class Solution {
    public int splitArray(int[] nums, int k) {
        int left=getMax(nums);
        int right=getTotal(nums);
        int ans=0;
        while(left<=right){
int mid=left+(right-left)/2;
int check=fn(nums,mid,k);
if(check<=k){
    ans=mid;
    right=mid-1;
}else if(check>k){
    left=mid+1;
}
        }
        return ans;
    }

    public int getMax(int nums[]){
        int max=Integer.MIN_VALUE;
for(int i=0;i<nums.length;i++){
max=Math.max(nums[i],max);
}
return max;
    }
    public int getTotal(int nums[]){
int sum=0;
for(int i=0;i<nums.length;i++){
    sum=sum+nums[i];
}
return sum;
    }
    public int fn(int nums[],int mid,int k){
int reqarrayscount=1;
int sum=0;
for(int i=0;i<nums.length;i++){
    if(nums[i]+sum<=mid){
        sum=sum+nums[i];
    }else{
         reqarrayscount++;
         sum=nums[i];
    }
}
return reqarrayscount;
    }
}
