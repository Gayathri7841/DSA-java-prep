class Solution {
    public int[] rearrangeArray(int[] nums) {
        int arr[]=new int[nums.length];
        int pi=0;
        int ni=1;

        for(int i=0;i<nums.length;i++){
if(nums[i]>0){
    arr[pi]=nums[i];
    pi=pi+2;
}else if(nums[i]<0){
    arr[ni]=nums[i];
    ni=ni+2;
}
        }
        return arr;
    }
}
