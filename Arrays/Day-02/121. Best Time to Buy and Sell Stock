class Solution {
    public int maxProfit(int[] prices) {
        int sum=0;
        int buy=prices[0];
        int maxprofit=0;
        for(int i=1;i<prices.length;i++){
            if(prices[i]<buy){
                buy=prices[i];
                sum=0;
            }
            else{
                sum=prices[i]-buy;
            }
            maxprofit=Math.max(maxprofit,sum);
        }
        return maxprofit;
    }
}
