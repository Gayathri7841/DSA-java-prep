class Solution {
    public int rowWithMax1s(int[][] mat) {
       int m=mat.length;
       int n=mat[0].length;
       int max=0;
       int index=-1;
       for(int i=0;i<m;i++){
        int count=fn(mat[i]);
        if(count>max){
            index=i;
            max=count;
        }
       }
       return index;
    }
    public int fn(int nums[]){
        int n=nums.length;
        int low=0;
        int high=n-1;
        int ans=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==1){
ans=mid;
high=mid-1;
            }else{
                low=mid+1;
            }
        }
     if(ans == -1) return 0;  // no 1s found
    return n - ans;
    }
}
