class Solution {
    public int floorSqrt(int n) {
     int low=1;
     int high=n;
     int ans=0;
     while(low<=high){
        int mid=low+(high-low)/2;
        if((long)mid*mid>n){
            high=mid-1;
        }else{
        ans=mid;
        low=mid+1;
        }
     }
     return ans; 
    }
}
