class Solution {
    
    int power(int mid, int N, int M) {
        long res = 1;

        for (int i = 0; i < N; i++) {
            res *= mid;

            if (res > M) {
                return 2; // greater than M
            }
        }

        if (res == M) return 1;
        return 0; // less than M
    }

    public int NthRoot(int N, int M) {

        int low = 1;
        int high = M;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            int ans = power(mid, N, M);

            if (ans == 1) {
                return mid;
            } 
            else if (ans == 2) {
                high = mid - 1;
            } 
            else {
                low = mid + 1;
            }
        }

        return -1;
    }
}
