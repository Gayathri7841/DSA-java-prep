class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int left=1;
        int right=getMax(nums);
        int ans=-1;
        while(left<=right){
            int mid=left+(right-left)/2;
int res=fn(nums,mid);
if(res<=threshold){
    ans=mid;
    right=mid-1;
}else{
    left=mid+1;
}
        }
        return ans;
    }
    public int fn(int nums[],int n){
        int sum=0;
        for(int i=0;i<nums.length;i++){
            int rem=(int)Math.ceil((double)nums[i]/n);
            sum=sum+rem;
        }
        return sum;
    }
    public int getMax(int nums[]){
         int max=Integer.MIN_VALUE;
        for(int i=0;i<nums.length;i++){
            max=Math.max(max,nums[i]);
        }
        return max;
    }
}
