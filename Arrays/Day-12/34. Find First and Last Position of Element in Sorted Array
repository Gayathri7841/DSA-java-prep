class Solution {
    public int[] searchRange(int[] nums, int target) {
        int first=findfirst(nums,target);
        int last=findlast(nums,target);
        int res[]=new int[2];
        res[0]=first;
        res[1]=last;
        return res;
    }

    public int findfirst(int nums[],int target){
        int left=0;
        int right=nums.length-1;
        int indx=-1;
       
        while(left<=right){
             int mid=(left+right)/2;
            if(nums[mid]==target){
indx=mid;
right=mid-1;
            }else if(target<nums[mid]){
                right=mid-1;
            }else{
                left=mid+1;
            }
        }
        return indx;
    }

public int findlast(int nums[],int target){
    int left=0;
    int right=nums.length-1;
    int indx=-1;
    
    while(left<=right){
        int mid=(left+right)/2;
          if(nums[mid]==target){
indx=mid;
left=mid+1;
            }
            else if(target<nums[mid]){
                right=mid-1;
            }else{
                left=mid+1;
            }
    }
    return indx;

    }
}

    
