class Solution {
    public int maxLen(int[] arr) {
       Map<Integer,Integer> map= new HashMap<>();
    int sum=0;
    int len=0;
    for(int i=0;i<arr.length;i++){
        sum=sum+arr[i];
        if(sum==0){
        len=i+1;
        }else{
            if(map.containsKey(sum)){
                len=Math.max(len,i-map.get(sum));
            }else{
                map.put(sum,i);
            }
        }
    }
    return len;
    }
}
