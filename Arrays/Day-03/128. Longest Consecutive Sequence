class Solution {
    public int longestConsecutive(int[] nums) {
        Set<Integer> set=new HashSet<>();
     int maxlen=0;
     int len=1;
        for(int i=0;i<nums.length;i++){
            set.add(nums[i]);
        }
        for(int num:set){
            if(!set.contains(num-1)){
                    len=1;
                    int curr=num;
                while(set.contains(curr+1)){
                    curr++;
                    len++;
                }
            }
maxlen=Math.max(maxlen,len);
        }
        return maxlen;
    }
}
