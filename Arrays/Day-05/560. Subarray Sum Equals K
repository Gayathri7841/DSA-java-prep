class Solution {
    public int subarraySum(int[] nums, int k) {
            int count=0;
            int sum=0;
            int n=nums.length;
            Map<Integer,Integer> map=new HashMap<>();
            map.put(0,1);
            for(int i=0;i<n;i++){
                sum=sum+nums[i];
int res=sum-k;
if(map.containsKey(res)){
    count+=map.get(res);
}
    map.put(sum,map.getOrDefault(sum,0)+1);

            }
            return count;
    }
}
