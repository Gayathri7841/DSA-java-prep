class Solution {
    public int passwordStrength(String password) {
        boolean[] seen=new boolean[128];
        int sum=0;
        for(char ch: password.toCharArray()){
            if(seen[ch]) continue;
            seen[ch]=true;
            if(ch>='a'&&ch<='z') sum=sum+1;
            else if(ch>='A'&&ch<='Z') sum=sum+2;
            else if(ch>='0'&&ch<='9') sum=sum+3;
            else sum=sum+5;
        }
        return sum;
    }
}
