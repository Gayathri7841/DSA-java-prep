/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int maxDepth(TreeNode root) {
        int res=fn(root,0);
        return res;
    }
    public int fn(TreeNode root,int count){
        if(root==null) return count;
        int left=fn(root.left,count+1);
        int right=fn(root.right,count+1);
        return Math.max(left,right);
    }
}
