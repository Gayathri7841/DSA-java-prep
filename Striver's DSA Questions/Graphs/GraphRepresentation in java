2 ways we can represent a graph 
1-using adjacency matrix
2-using adjacency list


-------------------------------------------------------using adjacency matrix---------------------------------------------------------------------------------
package Graphs;
import java.util.*;
public class Demo {
public static void printAdjMatrix(int[][] edge,int n,int m) {
	int adj[][]=new int[n+1][n+1];
	for(int i=0;i<m;i++) {
		
			int u=edge[i][0];
			int v=edge[i][1];
			 adj[u][v]=1;
			 adj[v][u]=1;
		
	}
	for(int i=0;i<n+1;i++) {
		for(int j=0;j<n+1;j++) {
			System.out.print(adj[i][j]);
			}
	}
}
	
	
	public static void main(String[] args) {
		
		 Scanner sc = new Scanner(System.in);

	        // Number of nodes
	        int n = sc.nextInt();

	        // Number of edges
	        int m = sc.nextInt();

	        // Edge Array
	        int[][] edges = new int[m][2];

	        for (int i = 0; i < m; i++) {
	            edges[i][0] = sc.nextInt();
	            edges[i][1] = sc.nextInt();
	        }

	        printAdjMatrix(edges, n, m);

	            
	

}
}






------------------------------------------------------------------using adjacency List--------------------------------------------------------------------------





package Graphs;
import java.util.*;
public class Demo {
public static void printAdjList(int[][] edge,int n,int m) {
	List<Integer> adjlist[]=new ArrayList[n];
	for(int i=0;i<adjlist.length;i++) {
		adjlist[i]=new ArrayList<>();
	}
	

	for(int i=0;i<m;i++) {
		
		int u=edge[i][0];
		int v=edge[i][1];
		
		adjlist[u].add(v);
		adjlist[v].add(u);
		
	}
	for (int i = 0; i < n; i++) {
	    System.out.print(i + " -> ");
	    System.out.println(adjlist[i]);
	}
	
}
	
	
	public static void main(String[] args) {
		
		 Scanner sc = new Scanner(System.in);

	        // Number of nodes
	        int n = sc.nextInt();

	        // Number of edges
	        int m = sc.nextInt();

	        // Edge Array
	        int[][] edges = new int[m][2];

	        for (int i = 0; i < m; i++) {
	            edges[i][0] = sc.nextInt();
	            edges[i][1] = sc.nextInt();
	        }

	        printAdjList(edges, n, m);

	            
	

}
}

















