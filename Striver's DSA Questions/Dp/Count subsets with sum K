Given an array arr of n integers and an integer K, count the number of subsets of the given array that have a sum equal to K. Return the result modulo (109 + 7).


Example 1

Input: arr = [2, 3, 5, 16, 8, 10], K = 10

Output: 3

Explanation: The subsets are [2, 8], [10], and [2, 3, 5].

Example 2

Input: arr = [1, 2, 3, 4, 5], K = 5

Output: 3

Explanation: The subsets are [5], [2, 3], and [1, 4].




class Solution {
    int [] arr;
    int k;
    int dp[][];
    static final int mod = 1_000_000_007;
    public int perfectSum(int[] arr, int K) {
  this.arr=arr;
  k=K;
  dp=new int[arr.length][k+1];
  for (int[] row : dp)
    Arrays.fill(row, -1);
  return dfs(0,0);
    }
    private int dfs(int index,int sum){
       
         if(sum>k) return 0;
        if(index==arr.length){
            if(sum==k) return 1;
            return 0;
        }
       
        if(dp[index][sum]!=-1) return dp[index][sum];
        int pick=dfs(index+1,sum+arr[index]);
        int notpick=dfs(index+1,sum);
        return dp[index][sum]=(pick+notpick)%mod;
    }
}

