Given two strings str1 and str2, find the length of their longest common substring.



A substring is a contiguous sequence of characters within a string.


Example 1

Input: str1 = "abcde", str2 = "abfce"

Output: 2

Explanation: The longest common substring is "ab", which has a length of 2.

Example 2

Input: str1 = "abcdxyz", str2 = "xyzabcd"

Output: 4

Explanation: The longest common substring is "abcd", which has a length of 4.




Constraints

n=str1.length
m=str2.length
1<= n, m <=103
str1 and str2 are in lowercase alphabet





class Solution {
     String str1;
    String str2;
    int s1;
    int s2;
    Integer dp[][];
    public int longestCommonSubstr(String str1, String str2) {
     this.str1=str1;
     this.str2=str2;
     s1=str1.length();
     s2=str2.length();
     dp=new Integer[s1][s2];
     return fn(0,0);
    }
     private int fn(int i1,int i2){
        if(i1>=s1||i2>=s2) return 0;
if(dp[i1][i2]!=null) return dp[i1][i2];
      int ans=0;
        if(str1.charAt(i1)==str2.charAt(i2)){
  ans=Math.max(ans,1+fn(i1+1,i2+1));
  dp[i1][i2]=ans;

        }else{
            dp[i1][i2]=0;
        }
      
    
 return dp[i1][i2];
    
       
    }
}
