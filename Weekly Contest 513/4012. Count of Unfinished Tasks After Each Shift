class Solution {
    public int[] countTasks(int[] tasks, int[] shifts) {
        int n= tasks.length;
        int m=shifts.length;
        long prefix[]=new long[n+1];
        prefix[0]=0;
        for(int i=0;i<n;i++){
            prefix[i+1]=prefix[i]+tasks[i];
        }
       
        
       int ans[]=new int[m];
        long done=0;
        for(int i=0;i<m;i++){
            done+=shifts[i];
            if(done>=prefix[n]){
                ans[i]=0;
                done=0;
                continue;
                
            }
            int l=1,r=n;
            while(l<=r){
                int mid=l+(r-l)/2;
                if(prefix[mid]<=done) l=mid+1;
                else r=mid-1;
            }
            ans[i]=n-(l-1);
        }
        return ans;
    }
}
