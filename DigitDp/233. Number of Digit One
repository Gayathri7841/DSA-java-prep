class Solution {
    String num;
    Long dp[][][];
    public int countDigitOne(int n) {
        num=String.valueOf(n);
        int len=num.length();
        dp=new Long[len][len+1][2];
        return (int)dfs(0,0,1);
    }
    public long dfs(int pos,int count,int tight){
          if(pos==num.length()) return count;
          if(dp[pos][count][tight]!=null) return dp[pos][count][tight];
      
        int limit;
      if(tight==1){
limit=num.charAt(pos)-'0';
      }else{
        limit=9;
      }
      long ans=0;
for(int digit=0;digit<=limit;digit++){
    
    int newtight;
    if(tight==1&&digit==limit){
        newtight=1;
    }else{
        newtight=0;
    }
    if(digit==1) ans=ans+dfs(pos+1,count+1,newtight);
    else ans=ans+dfs(pos+1,count,newtight);
}
dp[pos][count][tight]=ans;
return dp[pos][count][tight];
    }
}
